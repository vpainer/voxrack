<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Golos.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- акцент не задаём: окно берёт системный цвет Windows; тема — тоже системная (светлая или тёмная) -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF"/>
          <SolidColorBrush x:Key="LedOffFill" Color="#3A3E44"/>
          <SolidColorBrush x:Key="LedOffStroke" Color="#4A4F56"/>
          <SolidColorBrush x:Key="LedHoverStroke" Color="#8A8F96"/>
          <SolidColorBrush x:Key="LedPressStroke" Color="#D9DBDE"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF"/>
          <SolidColorBrush x:Key="LedOffFill" Color="#3A3E44"/>
          <SolidColorBrush x:Key="LedOffStroke" Color="#4A4F56"/>
          <SolidColorBrush x:Key="LedHoverStroke" Color="#8A8F96"/>
          <SolidColorBrush x:Key="LedPressStroke" Color="#D9DBDE"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="TrackBrush" Color="#2B000000"/>
          <SolidColorBrush x:Key="LedOffFill" Color="#D3D6DB"/>
          <SolidColorBrush x:Key="LedOffStroke" Color="#B4B8BE"/>
          <SolidColorBrush x:Key="LedHoverStroke" Color="#6E737A"/>
          <SolidColorBrush x:Key="LedPressStroke" Color="#1F2328"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="TrackBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
          <SolidColorBrush x:Key="LedOffFill" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="LedOffStroke" Color="{ThemeResource SystemColorWindowTextColor}"/>
          <SolidColorBrush x:Key="LedHoverStroke" Color="{ThemeResource SystemColorHighlightColor}"/>
          <SolidColorBrush x:Key="LedPressStroke" Color="{ThemeResource SystemColorHighlightColor}"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <SolidColorBrush x:Key="RecBrush" Color="#FF5148"/>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

      <!-- светодиод модуля: маленькая круглая кнопка-переключатель -->
      <Style x:Key="LedToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualMargin" Value="-2"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Grid x:Name="Root" Background="Transparent">
                <Ellipse x:Name="Glow" Width="14" Height="14" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0"/>
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{ThemeResource LedOffFill}" Stroke="{ThemeResource LedOffStroke}" StrokeThickness="1"/>
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="Dot.Stroke" Value="{ThemeResource LedHoverStroke}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="Dot.Stroke" Value="{ThemeResource LedPressStroke}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <VisualState.Setters>
                        <Setter Target="Root.Opacity" Value="0.4"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                      <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <Setter Target="Dot.Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <Setter Target="Glow.Opacity" Value="0.22"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPointerOver">
                      <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <Setter Target="Dot.Stroke" Value="{ThemeResource LedPressStroke}"/>
                        <Setter Target="Glow.Opacity" Value="0.3"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPressed">
                      <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <Setter Target="Glow.Opacity" Value="0.4"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedDisabled">
                      <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <Setter Target="Root.Opacity" Value="0.4"/>
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- кнопки шапки: компактные, как в инструментах -->
      <Style x:Key="BarToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="BarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <Style x:Key="CtrlLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextLineBounds" Value="Tight"/>
      </Style>
      <Style x:Key="RailHeadStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="120"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
