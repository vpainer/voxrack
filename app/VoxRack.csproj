<Project Sdk="Microsoft.NET.Sdk">

  <!-- VoxRack: окно на WinUI 3 (Mica). Ядро (общая память, звук, установка, EQ Match, MV7) — в ../core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Golos</RootNamespace>
    <AssemblyName>VoxRack</AssemblyName>
    <Product>VoxRack</Product>
    <Description>Studio voice chain built into your Windows microphone</Description>
    <Authors>Victor Painer</Authors>
    <Copyright>Copyright © 2026 Victor Painer. GPL-3.0-or-later</Copyright>
    <Version>1.0.0</Version>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <!-- ядро: общая память, звук, установка, EQ Match, сам MV7 -->
  <ItemGroup>
    <Compile Include="..\core\Shm.cs" Link="Core\Shm.cs" />
    <Compile Include="..\core\Analyzer.cs" Link="Core\Analyzer.cs" />
    <Compile Include="..\core\AudioHost.cs" Link="Core\AudioHost.cs" />
    <Compile Include="..\core\Installer.cs" Link="Core\Installer.cs" />
    <Compile Include="..\core\EqMatch.cs" Link="Core\EqMatch.cs" />
    <Compile Include="..\core\Mv7.cs" Link="Core\Mv7.cs" />
  </ItemGroup>

  <!-- нативные части (apo/build.sh) и установщик — рядом с exe -->
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\build\GolosAPO.dll" Link="GolosAPO.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\build\GolosDsp.dll" Link="GolosDsp.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\build\golosctl.exe" Link="golosctl.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tools\install-apo.ps1" Link="install-apo.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- автономная сборка: AI/ML и виджеты Windows App SDK программе не нужны (onnxruntime, DirectML — ~43 МБ) -->
  <Target Name="DropUnusedAppSdkParts" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_VrUnused Include="$(PublishDir)onnxruntime*.dll;$(PublishDir)DirectML.dll;$(PublishDir)Microsoft.Windows.Widgets.*" />
    </ItemGroup>
    <Delete Files="@(_VrUnused)" />
    <RemoveDir Directories="$(PublishDir)NpuDetect" />
  </Target>

</Project>
